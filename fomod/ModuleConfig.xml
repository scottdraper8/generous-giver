<?xml version='1.0' encoding='utf-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Generous Giver</moduleName>
  <installSteps order="Explicit">
    <installStep name="Gek, Korvax, and Vy'keen Settings">
      <optionalFileGroups order="Explicit">
        <group name="Choose an Exact Amount" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="5">
              <description>Give 5 gifts and receive 5 standing. This amount also controls the Autophage multiplier when enabled on the next page.</description>
              <image path="fomod/images/korvax-5.jpg" />
              <files>
                <folder source="fomod/files/5" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
              <conditionFlags>
                <flag name="gift_amount">5</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="10">
              <description>Give 10 gifts and receive 10 standing. This amount also controls the Autophage multiplier when enabled on the next page.</description>
              <image path="fomod/images/korvax-10.jpg" />
              <files>
                <folder source="fomod/files/10" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
              <conditionFlags>
                <flag name="gift_amount">10</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="15">
              <description>Give 15 gifts and receive 15 standing. This amount also controls the Autophage multiplier when enabled on the next page.</description>
              <image path="fomod/images/vykeen-15.jpg" />
              <files>
                <folder source="fomod/files/15" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
              <conditionFlags>
                <flag name="gift_amount">15</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="20">
              <description>Give 20 gifts and receive 20 standing. This amount also controls the Autophage multiplier when enabled on the next page.</description>
              <image path="fomod/images/gek-20.jpg" />
              <files>
                <folder source="fomod/files/20" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
              <conditionFlags>
                <flag name="gift_amount">20</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="Dialogue Behavior" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Keep Dialogue Open">
              <description>Leave Gek, Korvax, and Vy'keen dialogue open after giving a gift.</description>
              <image path="fomod/images/normal-dialogue-open.gif" />
              <conditionFlags>
                <flag name="dialogue_mode">open</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Close dialogue (normal behavior)">
              <description>Close Gek, Korvax, and Vy'keen dialogue after giving a gift.</description>
              <image path="fomod/images/normal-dialogue-closed.gif" />
              <conditionFlags>
                <flag name="dialogue_mode">closed</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Autophage Settings">
      <optionalFileGroups order="Explicit">
        <group name="Autophage Gift Multiplier" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Enable Multiplier">
              <description>Apply the selected gift amount to Autophage gift costs and standing rewards.</description>
              <image path="fomod/images/autophage-10.jpg" />
              <conditionFlags>
                <flag name="autophage_multiplier">enabled</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Disable Multiplier">
              <description>Leave Autophage gift costs and standing rewards at their vanilla amounts.</description>
              <image path="fomod/images/autophage-multiplier-disabled.jpg" />
              <conditionFlags>
                <flag name="autophage_multiplier">disabled</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="Autophage Dialogue Behavior" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Keep dialogue open and cycle gift option">
              <description>Keep the dialogue open and reseed the Autophage to request another gift after each gift.</description>
              <image path="fomod/images/autophage-dialogue-open.gif" />
              <conditionFlags>
                <flag name="autophage_dialogue">keep</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Close dialogue and remove ability to regift that NPC (normal behavior)">
              <description>Use vanilla behavior: close the dialogue and remove the gift option for that Autophage.</description>
              <image path="fomod/images/autophage-dialogue-closed.gif" />
              <conditionFlags>
                <flag name="autophage_dialogue">remove</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
