<?xml version="1.0" encoding="UTF-8"?>
<config>
  <moduleName>Generous Giver</moduleName>
  <installSteps order="Explicit">
    <installStep name="Gift amount">
      <optionalFileGroups order="Explicit">
        <group name="Choose an exact amount" type="SelectExactlyOne">
          <plugins>
            <plugin name="5">
              <description>Consume exactly 5 matching items and grant +5 standing in the existing Gek, Korvax, and Vy'keen standard and outlaw standing-gift conversations.</description>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
              <files>
                <folder source="fomod/files/5" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
            </plugin>
            <plugin name="10">
              <description>Consume exactly 10 matching items and grant +10 standing in the existing Gek, Korvax, and Vy'keen standard and outlaw standing-gift conversations.</description>
