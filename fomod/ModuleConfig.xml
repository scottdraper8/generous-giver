                <type name="Optional" />
              </typeDescriptor>
              <files>
                <folder source="fomod/files/10" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
            </plugin>
            <plugin name="15">
              <description>Consume exactly 15 matching items and grant +15 standing in the existing Gek, Korvax, and Vy'keen standard and outlaw standing-gift conversations.</description>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
              <files>
                <folder source="fomod/files/15" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
            </plugin>
            <plugin name="20">
              <description>Consume exactly 20 matching items and grant +20 standing in the existing Gek, Korvax, and Vy'keen standard and outlaw standing-gift conversations.</description>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
              <files>
                <folder source="fomod/files/20" destination="GAMEDATA/MODS/GenerousGiver" />
              </files>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
